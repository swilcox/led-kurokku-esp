# Rust often needs a bit of extra main task stack size compared to C (the default is 3K)
CONFIG_MAIN_TASK_STACK_SIZE=8000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms granularity by default).
CONFIG_FREERTOS_HZ=1000

# 4MB flash (standard for most ESP32-C3 modules)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table with 1.875MB OTA slots (firmware exceeds the built-in 1MB slots)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable HTTPS for OTA downloads
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
